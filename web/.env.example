# PhantomVault Environment Configuration
NODE_ENV=development
SESSION_SECRET=your_32_char_session_secret_key_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# AI Configuration (auto = uses GEMMA_API_KEY if provided, else falls back to local engine)
AI_PROVIDER=auto
GEMMA_API_KEY=your_gemini_or_gemma_api_key_here
GEMMA_MODEL=gemma-4-31b-it
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_MS=25000

# Limits & Retention
DATA_RETENTION_DAYS=30
SEED_DEMO_DATA=false
MAX_TURNS_PER_INCIDENT=40
MAX_TRAPS_PER_USER=25
